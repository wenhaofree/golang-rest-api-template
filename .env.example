# 环境变量配置示例文件
# 复制此文件为 .env 并根据你的环境修改相应的值

# 数据库配置
POSTGRES_HOST=localhost
POSTGRES_DB=go_app_dev
POSTGRES_USER=docker
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# Redis配置
REDIS_HOST=localhost

# JWT配置 - 生产环境请使用安全的密钥
JWT_SECRET_KEY=your-jwt-secret-key-here
API_SECRET_KEY=your-api-secret-key-here

# JWT Token 有效期配置
# 支持的时间单位: s(秒), m(分钟), h(小时), d(天)
# 示例: 5m=5分钟, 2h=2小时, 1d=1天, 24h=24小时
JWT_EXPIRY_DURATION=24h

# bcrypt配置 - 密码哈希强度
# 10: 快速(~65ms) - 开发环境推荐
# 11: 平衡(~130ms) - 测试环境
# 12: 安全(~250ms) - 生产环境推荐
# 13: 高安全(~520ms) - 高安全要求
# 注意：cost=14+ 会导致响应时间超过1秒，严重影响用户体验
BCRYPT_COST=10

# MongoDB配置 - 日志存储
# 设置为 false/0/no/off/disable/disabled 可禁用MongoDB功能
MONGO_ENABLED=true
MONGO_URI=mongodb://localhost:27017
MONGO_DB=logging
MONGO_LOG_COLLECTION=logs

# 应用配置
GIN_MODE=debug
PORT=8001

# 日志配置
LOG_LEVEL=info                   # 日志级别: debug/info/warn/error
LOG_COLORIZED=true              # 是否启用彩色日志输出

# 环境特定配置说明：
# - 创建 .env.development 用于开发环境特定配置
# - 创建 .env.production 用于生产环境特定配置  
# - 创建 .env.test 用于测试环境特定配置
# - 创建 .env.local 用于本地覆盖配置（不应提交到版本控制）

# 配置加载优先级：
# 1. .env (基础配置)
# 2. .env.{environment} (环境特定配置)
# 3. .env.local (本地覆盖配置)
# 4. 系统环境变量 (最高优先级)