# 开发环境配置 - 性能优化版本
GIN_MODE=debug

# bcrypt配置 - 开发环境性能优化
# 使用cost=10以获得最佳开发体验 (~65ms响应时间)
BCRYPT_COST=10

# JWT配置 - 开发环境
JWT_SECRET_KEY=dev-jwt-secret-key-for-development-only
API_SECRET_KEY=dev-api-secret-key-for-development-only

# 开发环境数据库
POSTGRES_HOST=localhost
POSTGRES_DB=goapi_dev
POSTGRES_USER=root
POSTGRES_PASSWORD=fuwenhao
POSTGRES_PORT=5432

# 开发环境Redis
REDIS_HOST=localhost

# 开发环境MongoDB - 禁用以提高性能
MONGO_ENABLED=false

# 开发环境端口
PORT=8001

# 性能说明：
# - BCRYPT_COST=10 提供足够安全性的同时保证快速响应
# - MONGO_ENABLED=false 减少不必要的日志开销
# - 预期登录响应时间：< 100ms