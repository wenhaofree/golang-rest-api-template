# 生产环境配置
GIN_MODE=release

# bcrypt配置 - 生产环境使用更高的安全级别
BCRYPT_COST=12

# JWT配置 - 生产环境
# JWT_SECRET_KEY=your-production-jwt-secret-key-here
# API_SECRET_KEY=your-production-api-secret-key-here

# JWT Token 有效期 - 生产环境设置为24小时
JWT_EXPIRY_DURATION=24h

# bcrypt配置 - 生产环境使用更高的安全级别
BCRYPT_COST=12

# JWT配置 - 生产环境
# JWT_SECRET_KEY=your-production-jwt-secret-key-here
# API_SECRET_KEY=your-production-api-secret-key-here

# JWT Token 有效期 - 生产环境设置为24小时
JWT_EXPIRY_DURATION=24h

# 生产环境数据库 - 使用环境变量或Secrets管理
# POSTGRES_HOST=prod-db-host
# POSTGRES_DB=goapi_prod
# POSTGRES_USER=prod_user
# POSTGRES_PASSWORD=secure_password
# POSTGRES_PORT=5432

# 生产环境Redis
# REDIS_HOST=prod-redis-host

# 生产环境MongoDB - 通常启用以获得完整日志
MONGO_ENABLED=true
# MONGO_URI=mongodb://prod-mongo-cluster:27017
MONGO_DB=prod_logging
MONGO_LOG_COLLECTION=api_logs

# 生产环境端口
PORT=8001

# 生产环境日志配置
LOG_LEVEL=info
LOG_COLORIZED=false             # 生产环境通常禁用颜色以便日志收集

# 生产环境速率限制配置（更严格）
RATE_LIMIT_REQUESTS=60          # 生产环境限制更严格
RATE_LIMIT_WINDOW=60            # 60秒窗口

# 注意：生产环境的敏感信息应该通过环境变量或Secrets管理系统注入
# 不要在.env文件中存储真实的生产凭据